# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

GET         /                          controllers.HomeController.index()
GET         /orders                    controllers.OrdersController.index()
GET         /products                  controllers.ProductsController.index()
GET         /product/edit/:id          controllers.ProductsController.editView(id:  Long)
POST        /product/edit/:id          controllers.ProductsController.edit(id:  Long)
GET         /product/create            controllers.ProductsController.createView()
POST        /product/create            controllers.ProductsController.create()
POST        /product/delete/:id        controllers.ProductsController.delete(id:  Long)
POST        /product/upload            controllers.ProductsController.upload()

# Map static resources from the /public folder to the /assets URL path
GET         /assets/*file              controllers.Assets.versioned(path="/public", file: Asset)
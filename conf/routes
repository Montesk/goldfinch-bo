# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

GET         /                           controllers.HomeController.index()

GET         /products                   controllers.ProductsController.index()
GET         /product/$id<[0-9]+>        controllers.ProductsController.view(id:  Long)
GET         /product/edit/:id           controllers.ProductsController.editView(id:  Long)
POST        /product/edit/:id           controllers.ProductsController.edit(id:  Long)
GET         /product/create             controllers.ProductsController.createView()
POST        /product/create             controllers.ProductsController.create()
POST        /product/delete/:id         controllers.ProductsController.delete(id:  Long)
POST        /product/upload             controllers.ProductsController.upload()

GET         /orders                     controllers.OrdersController.index()

GET         /delivery                   controllers.DeliveriesController.index()
GET         /delivery/create            controllers.DeliveriesController.createView()
POST        /delivery/create            controllers.DeliveriesController.create()
GET         /delivery/edit/:id          controllers.DeliveriesController.editView(id:  Long)
POST        /delivery/edit/:id          controllers.DeliveriesController.edit(id:  Long)
POST        /delivery/delete/:id        controllers.DeliveriesController.delete(id:  Long)

GET         /warehouses                 controllers.WarehousesController.index()
GET         /warehouse/create           controllers.WarehousesController.createView()
POST        /warehouse/create           controllers.WarehousesController.create()

GET         /settings                   controllers.SettingsController.index()
POST        /settings/editV2            controllers.SettingsController.editV2()

# deprecated
POST        /settings/edit              controllers.SettingsController.edit()

# Map static resources from the /public folder to the /assets URL path
GET         /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)